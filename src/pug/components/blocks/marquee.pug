mixin marquee(props = {})
  .marquee&attributes(attributes)
    .marquee__inner
      .marquee__box
        span Дело помощи утопающим — дело рук самих утопающих!
        span Шахматы двигают вперёд не только культуру, но и экономику!
        span Лёд тронулся, господа присяжные заседатели!
      .marquee__box(aria-hidden="true")
        span Дело помощи утопающим — дело рук самих утопающих!
        span Шахматы двигают вперёд не только культуру, но и экономику!
        span Лёд тронулся, господа присяжные заседатели!
